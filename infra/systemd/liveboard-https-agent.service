[Unit]
Description=LiveBoard HTTPS management agent
After=network-online.target nginx.service docker.service
Wants=network-online.target
Requires=nginx.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/liveboard/bin/liveboard-https-agent.py serve
Restart=on-failure
RestartSec=3
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/liveboard /etc/nginx/sites-available /run/liveboard -/run/nginx.pid -/var/log/nginx -/var/lib/nginx

[Install]
WantedBy=multi-user.target
