[Unit]
Description=Renew the LiveBoard HTTPS certificate
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/liveboard/bin/liveboard-https-agent.py renew
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/liveboard /etc/nginx/sites-available
