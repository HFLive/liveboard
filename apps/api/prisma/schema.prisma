generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  super_admin
  admin
  member
}

enum UserStatus {
  active
  disabled
}

enum PermissionLevel {
  owner
  editor
  lecturer
  viewer
  no_access
}

enum PermissionTargetType {
  workspace
  folder
  file
}

enum FileType {
  book
  lesson
  course
  exercise_set
  doc
  asset
}

enum FileStatus {
  draft
  published
  archived
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false
  fill_blank
  short_answer
}

enum SubmissionStatus {
  not_started
  in_progress
  submitted
  auto_graded
  needs_manual_review
  graded
  late
}

enum ClassroomMemberRole {
  teacher
  student
}

enum ForumThreadStatus {
  open
  locked
}

enum StorageBackend {
  minio
  oss
  r2
}

enum StorageDownloadMode {
  proxy
  direct
}

enum MigrationJobKind {
  export
  import
}

enum MigrationJobStatus {
  pending
  running
  succeeded
  failed
}

enum StorageUploadMode {
  relay
  direct
}

enum PendingUploadKind {
  asset
  classroom
  forum_image
  profile_banner
}

enum FileAssetKind {
  embedded
  standalone
}

model User {
  id                   String         @id @default(cuid())
  username             String         @unique
  displayName          String
  passwordHash         String
  avatarStorageKey     String?
  avatarMimeType       String?
  avatarUpdatedAt      DateTime?
  avatarStorageBackend StorageBackend @default(minio)
  bio                  String?
  bannerStorageKey     String?
  bannerMimeType       String?
  bannerUpdatedAt      DateTime?
  bannerStorageBackend StorageBackend @default(minio)
  sessionVersion       Int            @default(0)
  systemRole           SystemRole
  status               UserStatus     @default(active)
  storageQuotaBytes    Int?
  aiCallCount          Int            @default(0)
  aiCallLimit          Int?
  aiCallDateKey        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  createdFolders          Folder[]                @relation("FolderCreatedBy")
  createdFiles            File[]                  @relation("FileCreatedBy")
  updatedFiles            File[]                  @relation("FileUpdatedBy")
  tagAssignments          UserTagAssignment[]
  badgeAssignments        UserBadge[]             @relation("UserBadgeRecipient")
  awardedBadges           UserBadge[]             @relation("UserBadgeAwardedBy")
  createdBadges           Badge[]                 @relation("BadgeCreatedBy")
  permissionGrants        PermissionGrant[]       @relation("PermissionGrantUser")
  createdPermissionGrants PermissionGrant[]       @relation("PermissionGrantCreatedBy")
  submissions             Submission[]
  aiConversations         AiConversation[]
  forumThreads            ForumThread[]           @relation("ForumThreadAuthor")
  forumPosts              ForumPost[]             @relation("ForumPostAuthor")
  teachingDecks           TeachingDeck[]          @relation("TeachingDeckCreatedBy")
  createdExerciseSets     ExerciseSet[]           @relation("ExerciseSetCreatedBy")
  uploadedAssets          FileAsset[]             @relation("FileAssetUploader")
  createdClassrooms       Classroom[]             @relation("ClassroomCreatedBy")
  classroomMemberships    ClassroomMember[]
  uploadedClassroomFiles  ClassroomFile[]         @relation("ClassroomFileUploader")
  classroomAnnouncements  ClassroomAnnouncement[]
  actedNotifications      Notification[]          @relation("NotificationActor")
  notificationRecipients  NotificationRecipient[]
  forumPostVotes          ForumPostVote[]
  migrationJobs           MigrationJob[]
  apiTokens               ApiToken[]              @relation("UserApiTokens")
}

/// 个人访问令牌（PAT）：MCP 等外部客户端以用户身份调用 API。
/// 只存 SHA-256 哈希，明文仅在创建时返回一次。
model ApiToken {
  id          String     @id @default(cuid())
  userId      String
  name        String
  tokenHash   String     @unique // SHA-256 hex
  tokenPrefix String // 明文前 10 位，管理端展示识别
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())

  user User @relation("UserApiTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id             String    @id @default(cuid())
  type           String
  category       String
  priority       String    @default("normal")
  actorId        String?
  classroomId    String?
  targetType     String
  targetId       String
  title          String
  detail         String
  href           String
  groupKey       String?
  aggregateCount Int       @default(1)
  occurredAt     DateTime  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  actor      User?                   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  classroom  Classroom?              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  recipients NotificationRecipient[]

  @@index([classroomId, occurredAt])
  @@index([category, occurredAt])
  @@index([groupKey, occurredAt])
}

model NotificationRecipient {
  notificationId String
  userId         String
  readAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, archivedAt, readAt, createdAt])
}

model ServerMetricSample {
  id                 String   @id @default(cuid())
  cpuUsagePercent    Float
  memoryUsagePercent Float
  diskUsagePercent   Float
  sampledAt          DateTime @default(now())

  @@index([sampledAt])
}

/**
 * 数据迁移任务记录（导出/导入）。数据不随迁移包带走（dump 排除其数据），
 * 导入期间目标库被重建时任务状态写本地状态文件（/data/migration/jobs/），
 * 还原完成后再 upsert 回本表（见 docs/migrate-any-direction-design.md §5.3）。
 */
model MigrationJob {
  id          String             @id @default(cuid())
  kind        MigrationJobKind
  status      MigrationJobStatus @default(pending)
  packageName String?
  appVersion  String?
  manifest    Json?
  phase       String          @default("")
  progress    Json?
  error       String?
  createdById String?
  createdAt   DateTime           @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  updatedAt   DateTime           @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById, createdAt])
}

model Workspace {
  id                         String         @id @default(cuid())
  name                       String
  slug                       String         @unique
  timeZone                   String         @default("Asia/Shanghai")
  faviconStorageKey          String?
  faviconMimeType            String?
  faviconUpdatedAt           DateTime?
  faviconStorageBackend      StorageBackend @default(minio)
  faviconLightStorageKey     String?
  faviconLightMimeType       String?
  faviconLightUpdatedAt      DateTime?
  faviconLightStorageBackend StorageBackend @default(minio)
  faviconDarkStorageKey      String?
  faviconDarkMimeType        String?
  faviconDarkUpdatedAt       DateTime?
  faviconDarkStorageBackend  StorageBackend @default(minio)
  memberAttachmentQuotaBytes Int?
  classroomStorageQuotaBytes Int?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  folders           Folder[]
  files             File[]
  userTags          UserTag[]
  badges            Badge[]
  permissionGrants  PermissionGrant[]
  assets            FileAsset[]
  aiSettings        AiSettings?
  aiProviderConfigs AiProviderConfig[]
  aiConversations   AiConversation[]
  forumCategories   ForumCategory[]
  forumThreads      ForumThread[]
  teachingDecks     TeachingDeck[]
  classrooms        Classroom[]
  storageSettings   StorageSettings?
  pendingUploads    PendingUpload[]
}

model ForumCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id])
  threads   ForumThread[]

  @@unique([workspaceId, name])
  @@index([workspaceId, sortOrder])
}

model ForumThread {
  id               String            @id @default(cuid())
  workspaceId      String
  categoryId       String
  authorId         String
  title            String
  isAnonymous      Boolean           @default(false)
  status           ForumThreadStatus @default(open)
  relatedResources Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lastActivityAt   DateTime          @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id])
  category  ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author    User          @relation("ForumThreadAuthor", fields: [authorId], references: [id])
  posts     ForumPost[]

  @@index([workspaceId, lastActivityAt])
  @@index([categoryId, lastActivityAt])
}

model ForumPost {
  id            String   @id @default(cuid())
  threadId      String
  parentId      String?
  replyToId     String?
  authorId      String
  body          String
  isAnonymous   Boolean  @default(false)
  upvoteCount   Int      @default(0)
  downvoteCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  thread          ForumThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parent          ForumPost?      @relation("ForumPostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         ForumPost[]     @relation("ForumPostReplies")
  replyTo         ForumPost?      @relation("ForumPostReplyTargets", fields: [replyToId], references: [id], onDelete: SetNull)
  targetedReplies ForumPost[]     @relation("ForumPostReplyTargets")
  author          User            @relation("ForumPostAuthor", fields: [authorId], references: [id])
  images          FileAsset[]     @relation("ForumPostImages")
  votes           ForumPostVote[]
  pendingUploads  PendingUpload[] @relation("PendingUploadForumPost")

  @@index([threadId, createdAt])
  @@index([parentId, createdAt])
  @@index([replyToId, createdAt])
  @@index([authorId, createdAt])
}

model ForumPostVote {
  postId    String
  userId    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, updatedAt])
}

model Folder {
  id          String   @id @default(cuid())
  workspaceId String
  parentId    String?
  name        String
  sortOrder   Int      @default(0)
  pinnedOrder Int?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  parent    Folder?     @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]    @relation("FolderTree")
  createdBy User        @relation("FolderCreatedBy", fields: [createdById], references: [id])
  files     File[]
  assets    FileAsset[]

  @@index([workspaceId, parentId, sortOrder])
  @@index([workspaceId, pinnedOrder])
}

model File {
  id             String     @id @default(cuid())
  workspaceId    String
  folderId       String
  type           FileType
  title          String
  status         FileStatus @default(draft)
  version        Int        @default(1)
  pinnedOrder    Int?
  importWarnings Json?
  createdById    String
  updatedById    String
  publishedAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  folder            Folder             @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdBy         User               @relation("FileCreatedBy", fields: [createdById], references: [id])
  updatedBy         User               @relation("FileUpdatedBy", fields: [updatedById], references: [id])
  blocks            ContentBlock[]
  exercise          ExerciseSet?
  assets            FileAsset[]
  teachingDeckItems TeachingDeckItem[] @relation("TeachingDeckItemSourceFile")

  @@index([folderId, status, updatedAt])
  @@index([workspaceId, pinnedOrder])
}

model UserTag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments UserTagAssignment[]

  @@unique([workspaceId, name])
  @@index([workspaceId, name])
}

model UserTagAssignment {
  tagId     String   @map("tagId")
  userId    String
  createdAt DateTime @default(now())

  tag  UserTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tagId, userId])
  @@index([userId])
}

model Badge {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String   @default("gold")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("BadgeCreatedBy", fields: [createdById], references: [id])
  assignments UserBadge[]

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model UserBadge {
  badgeId       String
  userId        String
  awardedById   String
  awardedAt     DateTime @default(now())
  equippedOrder Int?

  badge     Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user      User  @relation("UserBadgeRecipient", fields: [userId], references: [id], onDelete: Cascade)
  awardedBy User  @relation("UserBadgeAwardedBy", fields: [awardedById], references: [id])

  @@id([badgeId, userId])
  @@index([userId, equippedOrder])
  @@index([awardedById])
}

model PermissionGrant {
  id          String               @id @default(cuid())
  workspaceId String
  targetType  PermissionTargetType
  targetId    String
  userId      String
  level       PermissionLevel
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("PermissionGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User      @relation("PermissionGrantCreatedBy", fields: [createdById], references: [id])

  @@unique([targetType, targetId, userId])
  @@index([workspaceId, targetType, targetId])
  @@index([userId])
}

model ContentBlock {
  id            String   @id @default(cuid())
  fileId        String
  parentBlockId String?
  type          String
  sortOrder     Int      @default(0)
  dataJson      Json
  createdById   String
  updatedById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  file              File               @relation(fields: [fileId], references: [id], onDelete: Cascade)
  parent            ContentBlock?      @relation("BlockTree", fields: [parentBlockId], references: [id], onDelete: Cascade)
  child             ContentBlock[]     @relation("BlockTree")
  teachingDeckItems TeachingDeckItem[] @relation("TeachingDeckItemSourceBlock")

  @@index([fileId, sortOrder])
}

model ExerciseSet {
  id                       String    @id @default(cuid())
  classroomId              String
  title                    String
  createdById              String
  fileId                   String?   @unique
  openAt                   DateTime?
  dueAt                    DateTime?
  allowMultipleSubmissions Boolean   @default(false)
  showAnswerAfterSubmit    Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  createdBy         User               @relation("ExerciseSetCreatedBy", fields: [createdById], references: [id])
  classroom         Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  file              File?              @relation(fields: [fileId], references: [id], onDelete: Cascade)
  questions         Question[]
  submissions       Submission[]
  teachingDeckItems TeachingDeckItem[]

  @@index([classroomId, updatedAt])
  @@index([createdById])
}

model TeachingDeck {
  id          String   @id @default(cuid())
  workspaceId String
  classroomId String
  title       String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id])
  classroom Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy User               @relation("TeachingDeckCreatedBy", fields: [createdById], references: [id])
  items     TeachingDeckItem[]

  @@index([classroomId, updatedAt])
  @@index([workspaceId, updatedAt])
  @@index([createdById])
}

model TeachingDeckItem {
  id            String   @id @default(cuid())
  deckId        String
  type          String
  sortOrder     Int      @default(0)
  sourceFileId  String?
  sourceBlockId String?
  exerciseSetId String?
  assetId       String?
  snapshotJson  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deck        TeachingDeck  @relation(fields: [deckId], references: [id], onDelete: Cascade)
  sourceFile  File?         @relation("TeachingDeckItemSourceFile", fields: [sourceFileId], references: [id], onDelete: SetNull)
  sourceBlock ContentBlock? @relation("TeachingDeckItemSourceBlock", fields: [sourceBlockId], references: [id], onDelete: SetNull)
  exerciseSet ExerciseSet?  @relation(fields: [exerciseSetId], references: [id], onDelete: SetNull)
  asset       FileAsset?    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([deckId, sortOrder])
  @@index([sourceFileId])
  @@index([sourceBlockId])
  @@index([exerciseSetId])
  @@index([assetId])
}

model Classroom {
  id                String   @id @default(cuid())
  workspaceId       String
  name              String
  description       String?
  createdById       String
  storageQuotaBytes Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User                    @relation("ClassroomCreatedBy", fields: [createdById], references: [id])
  members       ClassroomMember[]
  decks         TeachingDeck[]
  exercises     ExerciseSet[]
  files         ClassroomFile[]
  announcements ClassroomAnnouncement[]
  notifications Notification[]

  @@unique([workspaceId, name])
  @@index([workspaceId, updatedAt])
}

model ClassroomMember {
  classroomId String
  userId      String
  role        ClassroomMemberRole
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classroomId, userId])
  @@index([userId, role])
}

model ClassroomFile {
  id             String         @id @default(cuid())
  classroomId    String
  storageKey     String         @unique
  storageBackend StorageBackend @default(minio)
  filename       String
  mimeType       String
  sizeBytes      Int
  uploadedBy     String
  createdAt      DateTime       @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  uploader  User      @relation("ClassroomFileUploader", fields: [uploadedBy], references: [id])

  @@index([classroomId, createdAt])
  @@index([uploadedBy, createdAt])
}

model ClassroomAnnouncement {
  id          String   @id @default(cuid())
  classroomId String
  authorId    String
  title       String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([classroomId, createdAt])
  @@index([authorId])
}

model Question {
  id            String       @id @default(cuid())
  exerciseSetId String
  type          QuestionType
  promptJson    Json
  optionsJson   Json?
  answerJson    Json?
  score         Int
  required      Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  exerciseSet ExerciseSet        @relation(fields: [exerciseSetId], references: [id], onDelete: Cascade)
  answers     SubmissionAnswer[]
}

model Submission {
  id            String           @id @default(cuid())
  exerciseSetId String
  userId        String
  status        SubmissionStatus
  score         Int?
  maxScore      Int
  submittedAt   DateTime?
  gradedAt      DateTime?
  gradedById    String?
  feedback      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  exerciseSet ExerciseSet        @relation(fields: [exerciseSetId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id])
  answers     SubmissionAnswer[]

  @@index([exerciseSetId, userId, submittedAt])
}

model SubmissionAnswer {
  id           String   @id @default(cuid())
  submissionId String
  questionId   String
  answerJson   Json
  score        Int?
  feedback     String?
  autoGraded   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model FileAsset {
  id             String         @id @default(cuid())
  workspaceId    String
  folderId       String?
  fileId         String?
  forumPostId    String?
  storageKey     String         @unique
  storageBackend StorageBackend @default(minio)
  kind           FileAssetKind  @default(embedded)
  filename       String
  mimeType       String
  sizeBytes      Int
  width          Int?
  height         Int?
  sortOrder      Int?
  uploadedBy     String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  folder            Folder?            @relation(fields: [folderId], references: [id])
  file              File?              @relation(fields: [fileId], references: [id])
  forumPost         ForumPost?         @relation("ForumPostImages", fields: [forumPostId], references: [id], onDelete: Cascade)
  teachingDeckItems TeachingDeckItem[]
  uploader          User               @relation("FileAssetUploader", fields: [uploadedBy], references: [id])

  @@index([folderId, kind, createdAt])
  @@index([forumPostId, sortOrder])
  @@index([uploadedBy, createdAt])
}

model StorageSettings {
  id                  String              @id @default(cuid())
  workspaceId         String              @unique
  backend             StorageBackend      @default(minio)
  downloadMode        StorageDownloadMode @default(proxy)
  uploadMode          StorageUploadMode   @default(relay)
  ossRegion           String?
  ossBucket           String?
  ossEndpoint         String?
  ossAccessKeyId      String?
  ossAccessKeySecret  String?
  ossInternal         Boolean             @default(false)
  ossInternalEndpoint String?
  updatedById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/**
 * 签名直入(浏览器直传 OSS)的两阶段预留。签名时创建,确认上传后删除;
 * 超时未确认的行由后续签名请求惰性清理,对象尽力删除。
 */
model PendingUpload {
  id             String            @id @default(cuid())
  kind           PendingUploadKind
  workspaceId    String
  folderId       String?
  fileId         String?
  classroomId    String?
  forumPostId    String?
  storageBackend StorageBackend    @default(minio)
  filename       String
  mimeType       String
  sizeBytes      Int
  storageKey     String            @unique
  uploadedBy     String
  createdAt      DateTime          @default(now())
  expiresAt      DateTime

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  forumPost  ForumPost? @relation("PendingUploadForumPost", fields: [forumPostId], references: [id], onDelete: Cascade)

  @@index([uploadedBy, expiresAt])
  @@index([forumPostId])
}

model AiSettings {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  enabled          Boolean  @default(false)
  activeConfigId   String?  @unique
  maxContextFiles  Int      @default(6)
  maxContextChars  Int      @default(12000)
  defaultCallLimit Int      @default(100)
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id])
  activeConfig AiProviderConfig? @relation("ActiveAiConfig", fields: [activeConfigId], references: [id], onDelete: SetNull)
}

model AiProviderConfig {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  providerName String
  baseUrl      String
  model        String
  apiKey       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace         Workspace   @relation(fields: [workspaceId], references: [id])
  activeForSettings AiSettings? @relation("ActiveAiConfig")

  @@unique([workspaceId, name])
  @@index([workspaceId, updatedAt])
}

model AiConversation {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  title       String
  pinnedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  user      User        @relation(fields: [userId], references: [id])
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  sourcesJson    Json?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
