NODE_ENV=development
BACKUP_RETENTION_COUNT=10

# 部署目标：self_hosted（默认）或 vercel。业务行为统一以此变量为准。
DEPLOYMENT_TARGET=self_hosted
# 前端部署目标；Vercel 构建时设为 vercel，用于禁止直传失败后的中转回退。
NEXT_PUBLIC_DEPLOYMENT_TARGET=self_hosted

API_PORT=4000
TRUST_PROXY_HOPS=1
API_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://liveboard:replace-with-a-strong-password@localhost:5432/liveboard?schema=public
# 数据迁移数据目录（导出包/导入包/维护模式状态文件）。自托管经 docker-compose
# 把宿主 /opt/liveboard/migration 挂载到容器 /data/migration；本地开发可指向
# 可写目录，例如 MIGRATION_DATA_DIR=$(pwd)/.migration-data
# MIGRATION_DATA_DIR=/data/migration
# Vercel/Neon 等托管数据库的 Prisma migration 直连地址（runtime 用池化 DATABASE_URL）
# DIRECT_DATABASE_URL=postgresql://liveboard:replace-with-a-strong-password@host:5432/liveboard?schema=public
POSTGRES_DB=liveboard
POSTGRES_USER=liveboard
POSTGRES_PASSWORD=replace-with-a-strong-password
REDIS_URL=redis://localhost:6379

SESSION_SECRET=replace-with-a-long-random-secret
AI_ENCRYPTION_KEY=replace-with-a-long-random-secret
AI_RATE_LIMIT_MAX_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=900
AI_MAX_CONCURRENT_PER_USER=2
SESSION_COOKIE_SECURE=false

# 每日上传清理 Cron 的鉴权密钥；Vercel 环境必须设置为至少 32 字节的随机值
# CRON_SECRET=replace-with-a-long-random-secret

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=liveboard
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
MINIO_BUCKET=liveboard-assets

# ---- Vercel + Cloudflare R2（仅 Vercel 部署需要）----
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=（可选）R2 兼容网关（如本地 MinIO 联调）才需覆盖端点；真实 Cloudflare R2 省略。

# ---- 数据迁移的一次性 R2 交接凭据（用后即删，不落库不进日志）----
# 对象直推目标 R2（server→vercel 导出）/ 直拉源 R2（vercel→server 导入）时，
# 按方向配置下列前缀变量，4 个必须齐全（缺少任一变量会报错而非静默回退）：
# TARGET_R2_ACCOUNT_ID=
# TARGET_R2_BUCKET=
# TARGET_R2_ACCESS_KEY_ID=
# TARGET_R2_SECRET_ACCESS_KEY=
# SOURCE_R2_ACCOUNT_ID=
# SOURCE_R2_BUCKET=
# SOURCE_R2_ACCESS_KEY_ID=
# SOURCE_R2_SECRET_ACCESS_KEY=

# 可选：Vercel Web 静态资源提供方，支持 vercel（默认）、cloudflare、edgeone。
# 三套配置可以同时保留，切换时只修改 STATIC_ASSET_PROVIDER。
# STATIC_ASSET_PROVIDER=vercel
# CLOUDFLARE_PAGES_ASSET_ORIGIN=https://static.hsfz.live
# CLOUDFLARE_PAGES_PROJECT=liveboard-static
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# EDGEONE_ASSET_ORIGIN=https://static-eo.hsfz.live
# EDGEONE_PROJECT_NAME=liveboard-static-eo
# EDGEONE_API_TOKEN=
# 旧 Cloudflare 配置兼容项，新部署不要使用：
# NEXT_PUBLIC_ASSET_PREFIX=https://static.hsfz.live

NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
